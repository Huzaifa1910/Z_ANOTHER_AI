@AbapCatalog.sqlViewName: 'ZI_AFE_ITM'
@AbapCatalog.compiler.compareFilter: true
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'AFE Item Interface'
define view entity ZI_AFE_Item as select from ztb_afe_itm {
  key client,
  key item_uuid,
  parent_uuid,
  building_work,
  lab_equipment,
  furniture,
  it_infrastructure,
  fees,
  total_item_cost,
  created_by,
  created_at,
  last_changed_by,
  last_changed_at
}